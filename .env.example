# MediaJel GQL API endpoint
# Used in playground and HTTP code snippets.
# Leave this as localhost only if you are running gql-service yourself on :4000 —
# otherwise the playground fails with "Failed to fetch". Point it at dojo instead.
# Dojo:       https://graphql-dojo.dmp.mediajel.ninja/
# Production: https://graphql.dmp.cnna.io/
NEXT_PUBLIC_GQL_ENDPOINT=https://graphql-dojo.dmp.mediajel.ninja/

# OpenAI API key (for AI assistant)
OPENAI_API_KEY=sk-...

# OpenAI Assistant ID (optional, for enhanced AI with Notion knowledge base)
# If set, the chat will use OpenAI Assistants API with file_search
# Run knowledge-sync to create an assistant and vector store
# OPENAI_ASSISTANT_ID=asst_...
